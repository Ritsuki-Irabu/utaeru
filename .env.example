APP_NAME=ウタエル
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ITUNES_COUNTRY=jp
# YouTube Data API v3（MV候補検索用）
# Google Cloud Consoleで取得したAPIキーを、=の右側に貼り付けます。
YOUTUBE_API_KEY=
YOUTUBE_REGION=JP
YOUTUBE_MAX_RESULTS=10

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=utaeru
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 任意: DeezerでBPM未取得の場合の補助。取得時はGetSongBPMの利用規約・バックリンク要件に従う。
GETSONGBPM_API_KEY=

# 個人利用向け既定取得先。曲名・アーティストで歌詞を検索します。
# 別の歌詞APIへ差し替える場合は、{title, artist}を受けlyrics/source_urlを返すAPIを指定します。
LYRICS_API_URL=
LYRICS_API_TOKEN=

SANCTUM_STATEFUL_DOMAINS=localhost:5173
